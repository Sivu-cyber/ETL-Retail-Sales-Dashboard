    <DTS:Executable
      DTS:refId="Package\Execute SQL Task - Complete Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3E730BA8-90B2-4137-8CB9-D8FFD1B52CF7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task - Complete Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F44C85E8-C04E-447B-9896-108B8A96F050}"
          SQLTask:SqlStatementSource="UPDATE audit.ETL_Audit&#xA;SET&#xA;    EndTime = GETDATE(),&#xA;    Status = 'SUCCESS'&#xA;WHERE AuditID =&#xA;(&#xA;    SELECT MAX(AuditID)&#xA;    FROM audit.ETL_Audit&#xA;    WHERE PackageName = 'Master_ETL'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task - Update Audit"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{28BB94F7-C217-4F6C-A3C5-8E9BA699AC52}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task - Update Audit"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F44C85E8-C04E-447B-9896-108B8A96F050}"
          SQLTask:SqlStatementSource="UPDATE audit.ETL_Audit&#xA;SET&#xA;    SourceCount =&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM stg.Sales&#xA;        WHERE SaleDate &gt;&#xA;        (&#xA;            SELECT LastSuccessfulLoadDate&#xA;            FROM audit.ETL_Control&#xA;            WHERE ProcessName = 'Load_FactSales'&#xA;        )&#xA;    ),&#xA;&#xA;    TargetCount =&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM dw.FactSales f&#xA;        INNER JOIN dw.DimDate d&#xA;            ON f.DateKey = d.DateKey&#xA;        WHERE d.FullDate &gt;&#xA;        (&#xA;            SELECT LastSuccessfulLoadDate&#xA;            FROM audit.ETL_Control&#xA;            WHERE ProcessName = 'Load_FactSales'&#xA;        )&#xA;    ),&#xA;&#xA;    RejectedCount =&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM stg.RejectedSales&#xA;    )&#xA;&#xA;WHERE AuditID =&#xA;(&#xA;    SELECT MAX(AuditID)&#xA;    FROM audit.ETL_Audit&#xA;    WHERE PackageName = 'Master_ETL'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task- Audit"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0064265A-1B28-47BA-9795-723C87F1EEC6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task- Audit"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F44C85E8-C04E-447B-9896-108B8A96F050}"
          SQLTask:SqlStatementSource="INSERT INTO audit.ETL_Audit&#xA;(&#xA;    PackageName,&#xA;    StartTime,&#xA;    Status&#xA;)&#xA;VALUES&#xA;(&#xA;    'Master_ETL',&#xA;    GETDATE(),&#xA;    'RUNNING'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
